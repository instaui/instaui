{
  "name": "instaui",
  "version": "0.9.0-rc.1",
  "description": "Config-first CRUD for antd: define resources in TypeScript or JSON, get list, filters, forms, detail, actions and permissions.",
  "keywords": [
    "antd",
    "antd6",
    "ant-design",
    "crud",
    "admin",
    "admin-panel",
    "react",
    "config-driven",
    "server-driven-ui",
    "data-provider"
  ],
  "license": "MIT",
  "author": "kings1ay3r",
  "homepage": "https://github.com/instaui/instaui#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/instaui/instaui.git"
  },
  "bugs": {
    "url": "https://github.com/instaui/instaui/issues"
  },
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "src",
    "!src/**/*.test.*",
    "LICENSE",
    "README.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "build": "yarn clean && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "check:version": "node scripts/check-version.mjs",
    "check:package": "node scripts/check-package.mjs",
    "prepack": "yarn build",
    "ci": "yarn lint && yarn format:check && yarn typecheck && yarn test && yarn check:version && yarn check:package"
  },
  "peerDependencies": {
    "@ant-design/icons": "^5.6.0 || ^6.0.0",
    "antd": "^5.25.0 || ^6.0.0",
    "dayjs": "^1.11.0",
    "react": "^18.2.0 || ^19.0.0",
    "react-dom": "^18.2.0 || ^19.0.0",
    "react-router-dom": "^6.20.0 || ^7.0.0"
  },
  "devDependencies": {
    "@ant-design/icons": "^6.3.4",
    "@arethetypeswrong/cli": "^0.18.5",
    "@eslint/js": "^10.0.1",
    "@tanstack/react-query": "^5.90.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "antd": "^6.6.5",
    "dayjs": "^1.11.23",
    "eslint": "^10.11.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "jsdom": "^29.1.1",
    "msw": "^3.0.1",
    "prettier": "^3.9.9",
    "publint": "^0.3.24",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.4",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.0",
    "vite": "^8.3.1",
    "vitest": "^5.0.3"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": ">=22.13.0",
      "onFail": "warn"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "packageManager": "yarn@4.9.1"
}
